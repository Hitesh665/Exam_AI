# ==========================================
# ExamAI Configuration Template
# ==========================================

# Port for the Node/Express
PORT=3000

# Secret key used for signing JWT tokens (replace with a long, random string in production)
JWT_SECRET=examai_super_secure_jwt_token_secret_2026_change_in_production

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""
# Gemini Model name
# If you get a model-not-found error, check Google AI Studio for the current free model name.
GEMINI_MODEL=gemini-3-flash-preview

# MongoDB Atlas Cloud Database URI (Optional for local testing, recommended for production)
# Get your free connection string from https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/examai?retryWrites=true&w=majority
